// src/mount_op.pdx — mount.pdxfs.M2-002 (issue #5) + PFS-10 end-to-end
// adoption of the frozen path-based sys_mount ABI (paideia-os#2577).
//
// ==========================================================================
// Status (as of PFS-10, mount.pdxfs v1.1.5)
// ==========================================================================
//
// The three "KERNEL GAP" bullets this file carried from M2-002 through
// v1.1.4 are now CLOSED:
//
//   GAP #1 (sys_mount dispatch unwired) — CLOSED at R53.M2 (dispatch.pdx
//     L2464-L2473 is the real `dispatch_mount` register-shuffle +
//     `call sys_mount_shim` body, not an `-ENOSYS` stub).
//   GAP #2 (two incompatible target ABIs) — CLOSED at PFS-01, which
//     froze the dev-path-based ABI as the one that ships (see
//     design/pdxfs/sys-mount-abi.md §2 in the paideia-os monorepo). The
//     aspirational cap-slot ABI never landed and the dispatch comment
//     explicitly retracts it at dispatch.pdx L2440-L2443.
//   GAP #3 (KIND_PDXFS_MOUNT_TABLE PMT_OP_APPEND_ROW unwired) — CLOSED
//     at PFS-10, which lands a stub body in cap_handler_pdxfs_mount_
//     table (requires R_PMT_WRITE; returns 0). The real per-row _mount_
//     table[] allocation already happens implicitly inside sys_mount_
//     body's successful backend arm; the cap-invoke is now the
//     authoritative ABI edge.
//
// ==========================================================================
// Frozen sys_mount ABI (PFS-01), as consumed from ring 3
// ==========================================================================
//
// Standard Linux SYSCALL convention: rax = sysno (75), args in rdi/rsi/
// rdx/r10/r8. From design/pdxfs/sys-mount-abi.md §2.3 (post-shuffle view
// is dispatch's, pre-shuffle view is user's):
//
//   rax = 75                       SYS_MOUNT
//   rdi = a0 = dev_path_va         user VA, byte buffer, NOT NUL-term;
//                                   kernel shim bounces into a 256-byte
//                                   .bss scratch via user_read_bytes_via_
//                                   walk.
//   rsi = a1 = dev_path_len        u64, bytes, bounds [1..256]
//   rdx = a2 = mount_point_va      user VA, byte buffer, NOT NUL-term
//   r10 = a3 = mount_point_len     u64, bytes, bounds [1..256]
//   r8  = a4 = backend_id          u64, {0 = tmpfs, 5 = pdxfs_block}
//
// Return in rax:
//
//   [0..7]                mount_slot (success; _mount_table[] row index,
//                         0 is the pinned root slot).
//   0xFFFFED60..0xFFFFED67 sys_mount's own failure band (§2.6 of the
//                          frozen ABI doc). mount_op_invoke stashes the
//                          raw value into *out_raw_errno_ptr so main.pdx
//                          can feed it to mount_record_classify_mount_
//                          errno for a distinct per-code label.
//
// Success / failure discriminator: `cmp rax, 8; jae error` — mount slots
// never reach 8 (MOUNT_MAX = 8) and every sentinel sits in 0xFFFFEDxx
// which is >> 8 unsigned.
//
// ==========================================================================
// Dev-path construction (stop-gap until PFS-11 lands the real
// VOL_OP_QUERY_DEVICE_SLOT wire-through)
// ==========================================================================
//
// §2.8 of the frozen ABI defines the dev_path syntactic shape for
// backend_id = 5 (pdxfs_block):
//
//   /dev/pdxvol<H>    12 bytes, H = one hex digit '0'..'9' | 'a'..'f'
//                     encoding a volume-registry row_id in [0..16).
//
// At PFS-10 the client's `<volume-cap>` positional (e.g. "cap:volume:0x4")
// is parsed by VolumeCap::volume_cap_parse_slot into a cap-slot number;
// here we take `narrowed_volume_slot & 0xF` as the row_id, format it as
// a single hex digit, and splice it into the fixed 11-byte "/dev/pdxvol"
// prefix. This is the mapping PFS-10 adopts; PFS-11 will replace it with
// a real VOL_OP_QUERY_DEVICE_SLOT cap-invoke that resolves the slot to a
// device_slot without the modulo-16 narrowing. Volumes whose cap slot
// lands outside [0..16) today will collide on their low nibble — the
// SYS_MOUNT_ENODEV return band already covers that failure case
// end-to-end, so the collision surfaces as a clean kernel refusal rather
// than a mis-mount.
//
// ==========================================================================
// Encoder-pitfall discipline
// ==========================================================================
//
// No `add reg, [mem]` anywhere. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. No `imul`/`mul` — only `shl` by immediate for byte
// strides and `div` is not used in this file. Byte stores use `mov [reg],
// subreg` (al/cl/dl) per mount_record.pdx's established idiom.
// Reserved-label discipline: every branch label in this file is prefixed
// `mount_op_`. Multi-line `pub let foo = "..."` is avoided.
//
// Upstream: design/pdxfs/sys-mount-abi.md §2 (paideia-os, frozen ABI);
// design/tooling/volume-tooling-ux.md §4 (paideia-os); src/kernel/core/
// syscall/sys_mount.pdx + src/kernel/core/syscall/dispatch.pdx L2464-
// L2473 (paideia-os); src/kernel/core/cap/kind_pdxfs_mount_table.pdx
// (paideia-os, PMT_OP_APPEND_ROW landed PFS-10).

module MountOp = structure {

  // --- mount_op_invoke status codes. -------------------------------------
  pub let MOUNT_OP_OK         : u64 = 0
  pub let MOUNT_OP_ERR_KERNEL : u64 = 1

  // --- SC+ syscall IDs used directly by this file. -----------------------
  pub let MOUNT_OP_SC_MOUNT      : u64 = 75   // sys_mount (dispatch.pdx L738-739)
  pub let MOUNT_OP_SC_CAP_INVOKE : u64 = 4    // cap_invoke (dispatch.pdx L614-615)

  // --- backend_id passed to sys_mount. A KIND_VOLUME-backed mount is
  //     definitionally pdxfs-block (= MOUNT_BACKEND_PDXFS_BLOCK = 5 per
  //     core/fs/mount.pdx L46 and SYS_MOUNT_BACKEND_PDXFS_BLOCK per
  //     sys_mount.pdx L211). ----------------------------------------------
  pub let MOUNT_OP_BACKEND_PDXFS_BLOCK : u64 = 5

  // --- PFS-02 cap-slot assignment for the KIND_PDXFS_MOUNT_TABLE handle
  //     (per design/pdxfs/init-caps-seed-convention.md). Until that seed
  //     convention lands in the production _init_caps hook, the slot
  //     carries whatever the loader leaves there; mount_op_append_row's
  //     return value is DISCARDED (best-effort, matching every
  //     audit_emit call site in sys_mount.pdx / sys_umount.pdx) so a
  //     wrong-kind or missing cap simply surfaces as INVOKE_* and is
  //     ignored. --------------------------------------------------------
  pub let MOUNT_OP_PMT_CAP_SLOT_PLACEHOLDER : u64 = 3

  // --- KIND_PDXFS_MOUNT_TABLE op ordinal (now WIRED at PFS-10 — see
  //     kind_pdxfs_mount_table.pdx cap_handler_pdxfs_mount_table). ------
  pub let MOUNT_OP_PMT_OP_APPEND_ROW : u64 = 2

  // --- Success-vs-failure discriminator. MOUNT_MAX = 8 (core/fs/mount.
  //     pdx L24); any rax >= 8 from sys_mount is a sentinel in the
  //     0xFFFFED6x band. ------------------------------------------------
  pub let MOUNT_OP_MOUNT_MAX : u64 = 8

  // --- Argv::PA_FLAG_DRY_RUN, reproduced here as a raw immediate per
  //     this repo's own cross-file constant convention (main.pdx itself
  //     hardcodes 0x8). pub let u64 constants are compile-time values,
  //     not linkable data symbols, so every consumer repeats the
  //     literal with a comment. -----------------------------------------
  pub let MOUNT_OP_FLAG_DRY_RUN : u64 = 0x8

  // --- Dev-path construction (frozen ABI §2.8). The 11-byte prefix is
  //     ".rodata"; the 12-byte scratch is ".bss" and gets a per-call
  //     splice of the hex nibble at [11]. 12 bytes total — the frozen
  //     ABI consumes (ptr, len=12), no NUL terminator required.
  //     ---------------------------------------------------------------
  pub let mount_op_dev_prefix     : [u8; 12] = "/dev/pdxvol\0"
  pub let MOUNT_OP_DEV_PATH_LEN   : u64 = 12
  pub let MOUNT_OP_DEV_PREFIX_LEN : u64 = 11

  pub let mut mount_op_dev_path_scratch : [u8; 12] = uninit @align(8)

  // --- Mount-point length cap. Frozen ABI §2.4 accepts up to 256;
  //     the strlen loop below walks to the first NUL and refuses any
  //     path longer than MOUNT_OP_MP_LEN_MAX (surfacing as
  //     SYS_MOUNT_EINVAL_MP_LEN downstream). A zero-length path (NUL
  //     at offset 0) is passed through to the kernel which refuses
  //     with the same code. ---------------------------------------------
  pub let MOUNT_OP_MP_LEN_MAX : u64 = 256

  // ==========================================================================
  // mount_op_append_row(mount_id) -> ()
  //
  // Issues cap_invoke(MOUNT_OP_PMT_CAP_SLOT_PLACEHOLDER, PMT_OP_APPEND_ROW)
  // via SC+ ID 4 and discards the result. At PFS-10 the kernel-side op is
  // WIRED (kind_pdxfs_mount_table.pdx cap_handler_pdxfs_mount_table's
  // pmt_hn_append arm, requires R_PMT_WRITE, returns 0) but a tool-side
  // KIND_PDXFS_MOUNT_TABLE cap seed is still PFS-02 work; without the
  // cap slot the kernel returns INVOKE_* and we discard it exactly as
  // mkfs.pdxfs discards audit_emit returns (best-effort audit edge).
  //
  // mount_id arrives in rdi but is NOT folded into op_arg at this
  // landing: the kernel's PMT_OP_APPEND_ROW handler gates op_arg[63:8]
  // to zero (singleton row — PMT_MAX = 1). A future landing that
  // threads mount_slot through op_arg[63:8] will consume rdi; keeping
  // the arg in the signature preserves ABI shape stability.
  //
  // Pure leaf at the syscall boundary: rax/rdi/rsi are SysV caller-save,
  // no push/pop, no branch.
  // ==========================================================================
  pub let mount_op_append_row : (u64) -> () !{mem, sysreg} @{cap} =
    fn (mount_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "mount.pdxfs.M2-002 (#5) + PFS-10 (paideia-os#2577): mount_op_append_row entry point. mount_id arrives in rdi but is NOT yet folded into op_arg (kernel handler gates op_arg[63:8]==0 at this landing). Issues `mov rdi, 3 (MOUNT_OP_PMT_CAP_SLOT_PLACEHOLDER); mov rsi, 2 (MOUNT_OP_PMT_OP_APPEND_ROW); mov rax, 4 (MOUNT_OP_SC_CAP_INVOKE); syscall`. Return value in rax discarded -- best-effort per module header, matching every audit_emit call site's own discard-the-side-channel-result convention. No branch, no push/pop -- rax/rdi/rsi are all SysV caller-save. Labels: none (single straight-line block, nothing to prefix).",
      block: {
        mov rdi, 3;                          // MOUNT_OP_PMT_CAP_SLOT_PLACEHOLDER
        mov rsi, 2;                          // MOUNT_OP_PMT_OP_APPEND_ROW
        mov rax, 4;                          // MOUNT_OP_SC_CAP_INVOKE
        syscall;
        ret;
      }
    }

  // ==========================================================================
  // mount_op_build_dev_path(narrowed_volume_slot) -> ()
  //
  // Splices the fixed 11-byte "/dev/pdxvol" prefix into the 12-byte .bss
  // scratch and writes a single hex digit at [11] derived from
  // narrowed_volume_slot & 0xF.
  //
  //   rdi = narrowed_volume_slot
  //
  // Pure leaf. Register plan (all SysV caller-save):
  //   rdi    = narrowed_volume_slot (held across the prefix copy loop)
  //   rax,rcx = per-byte scratch
  //   r10     = &mount_op_dev_prefix     (prefix source)
  //   r11     = &mount_op_dev_path_scratch (destination)
  //   r9      = cursor (0..11)
  // ==========================================================================
  pub let mount_op_build_dev_path : (u64) -> () !{mem} @{} =
    fn (narrowed_volume_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-10 (paideia-os#2577): mount_op_build_dev_path. Splice /dev/pdxvol prefix (11 bytes from mount_op_dev_prefix) into mount_op_dev_path_scratch[0..11], then compute hex digit = (narrowed_volume_slot & 0xF) formatted as ASCII at scratch[11]. Pure leaf -- rax/rcx/rdi/r9/r10/r11 all SysV caller-save, no push/pop. Phase 1 (mount_op_bdp_copy): r9 walks 0..11, loading mount_op_dev_prefix[r9] into al (via `mov_b` into zeroed rax) and storing al into mount_op_dev_path_scratch[r9] with `mov [r11 + r9], al`. Phase 2: `mov rax, rdi; and rax, 0xF`; `cmp rax, 10; jl mount_op_bdp_digit`; `add rax, 0x57` (base 'a' - 10 = 0x61 - 10); `jmp mount_op_bdp_store`. mount_op_bdp_digit: `add rax, 0x30`. mount_op_bdp_store: `mov [r11 + 11], al`. No `add reg,[mem]` (every add operates on registers or an immediate). No `test`. No `imul`. Labels prefixed mount_op_bdp_.",
      block: {
        lea r10, [rip + mount_op_dev_prefix];
        lea r11, [rip + mount_op_dev_path_scratch];
        xor r9, r9;

      mount_op_bdp_copy:
        cmp r9, 11;                          // MOUNT_OP_DEV_PREFIX_LEN
        jge mount_op_bdp_tail;
        xor rax, rax;
        mov_b rax, [r10 + r9];
        mov [r11 + r9], al;
        add r9, 1;
        jmp mount_op_bdp_copy;

      mount_op_bdp_tail:
        mov rax, rdi;
        and rax, 0xF;
        cmp rax, 10;
        jl mount_op_bdp_digit;
        add rax, 0x57;                       // 'a' - 10 = 0x61 - 10 = 0x57
        jmp mount_op_bdp_store;

      mount_op_bdp_digit:
        add rax, 0x30;                       // '0'

      mount_op_bdp_store:
        mov [r11 + 11], al;
        ret;
      }
    }

  // ==========================================================================
  // mount_op_strlen_bounded(ptr) -> u64
  //     (byte count up to and NOT INCLUDING the NUL, capped at
  //      MOUNT_OP_MP_LEN_MAX+1; a return >= MOUNT_OP_MP_LEN_MAX means
  //      "too long, let the kernel refuse with EINVAL_MP_LEN")
  //
  //   rdi = ptr (NUL-terminated byte string, as handed by main.pdx from
  //              ParsedArgv.mount_point_ptr -- argv is NUL-terminated by
  //              the execve ABI, so this is safe)
  //
  // Pure leaf; rax/rcx/rdi SysV caller-save.
  // ==========================================================================
  pub let mount_op_strlen_bounded : (u64) -> u64 !{mem} @{} =
    fn (ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-10 (paideia-os#2577): bounded strlen for the frozen sys_mount ABI's dev_path_len / mount_point_len arg. Loads *ptr via `xor rcx,rcx; mov_b rcx,[rdi]`; cmp rcx,0 -> done; else add rax,1; add rdi,1; cmp rax, 256 (MOUNT_OP_MP_LEN_MAX); jae done (caller will see len >= 256, kernel will refuse with EINVAL_MP_LEN). Pure leaf -- rax/rcx/rdi SysV caller-save, no push/pop. No `add reg,[mem]`, no `test` mnemonic. Labels prefixed mount_op_sl_.",
      block: {
        xor rax, rax;

      mount_op_sl_loop:
        xor rcx, rcx;
        mov_b rcx, [rdi];
        cmp rcx, 0;
        je mount_op_sl_done;
        cmp rax, 256;                        // MOUNT_OP_MP_LEN_MAX
        jae mount_op_sl_done;                // over-cap: return 256, kernel refuses
        add rax, 1;
        add rdi, 1;
        jmp mount_op_sl_loop;

      mount_op_sl_done:
        ret;
      }
    }

  // ==========================================================================
  // mount_op_invoke(narrowed_volume_slot, mount_point_ptr, flags,
  //                 out_mount_id_ptr, out_raw_errno_ptr) -> u64
  //     (MOUNT_OP_OK | MOUNT_OP_ERR_KERNEL)
  //
  //   rdi = narrowed_volume_slot (from VolumeCap::volume_cap_resolve)
  //   rsi = mount_point_ptr      (NUL-terminated <mount-point>)
  //   rdx = flags                (ParsedArgv.flags; dry-run bit 0x8)
  //   rcx = out_mount_id_ptr     (u64 write target; always written)
  //   r8  = out_raw_errno_ptr    (u64 write target; raw syscall return
  //                               verbatim on MOUNT_OP_ERR_KERNEL, 0 on
  //                               success or dry-run)
  //
  // PFS-10 switches from the never-landed cap-slot ABI to the frozen
  // path-based ABI (design/pdxfs/sys-mount-abi.md §2). Caller-side
  // responsibilities:
  //
  //   1. Build "/dev/pdxvol<H>" (12 bytes) from narrowed_volume_slot &
  //      0xF (see §Dev-path construction above and the PFS-11 note on
  //      the real VOL_OP_QUERY_DEVICE_SLOT wire-through).
  //   2. Compute mount_point_len via mount_op_strlen_bounded.
  //   3. Issue the syscall with the frozen register layout.
  //   4. On a plausible-looking success (rax < MOUNT_MAX=8), issue the
  //      PMT_OP_APPEND_ROW cap-invoke (now kernel-wired per PFS-10) for
  //      the ABI-visible row-append audit edge.
  //
  // Register plan (all SysV callee-save; pushed on entry, popped in
  // reverse order before every return):
  //   rbx = narrowed_volume_slot (fed to mount_op_build_dev_path)
  //   r12 = mount_point_ptr      (fed to mount_op_strlen_bounded + syscall)
  //   r13 = flags                (dry-run gate; dead past the real path's
  //                               syscall site, repurposed to carry
  //                               mount_id across the nested append-row
  //                               call, matching the pre-PFS-10 shape)
  //   r14 = out_mount_id_ptr
  //   r15 = out_raw_errno_ptr    (staged into a callee-save slot because
  //                               the kernel's #743 info-leak hardening
  //                               zeroes every caller-save register
  //                               including r8 before every sysret)
  // ==========================================================================
  pub let mount_op_invoke : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{fs, cap} =
    fn (narrowed_volume_slot: u64) (mount_point_ptr: u64) (flags: u64) (out_mount_id_ptr: u64) (out_raw_errno_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, cap},
      justification: "mount.pdxfs.M2-002 (#5) + M3-004 (#10) + PFS-10 (paideia-os#2577): mount_op_invoke entry point. SysV callee-save discipline: push rbx/r12/r13/r14/r15 (5 registers, 40 bytes) before repurposing any of them -- popped in reverse order immediately before every return. rbx=narrowed_volume_slot, r12=mount_point_ptr, r13=flags, r14=out_mount_id_ptr, r15=out_raw_errno_ptr; all survive the nested calls (mount_op_build_dev_path, mount_op_strlen_bounded, mount_op_append_row) and every `syscall` per amd64 fast-syscall callee-save convention (SYSCALL preserves callee-save registers; #743 info-leak hardening zeroes caller-save registers only, which is why r15 is staged out of the caller-save r8 it arrived in). Gate: `mov rax, r13; and rax, 0x8 (MOUNT_OP_FLAG_DRY_RUN); cmp rax, 0; jne mount_op_dry_run`. Dry-run arm: `xor rax,rax; mov [r14],rax; mov [r15],rax; xor rax,rax (MOUNT_OP_OK); jmp epilogue`. Real-mount arm (PFS-10): (1) `mov rdi, rbx; call mount_op_build_dev_path` splices /dev/pdxvol<H> into mount_op_dev_path_scratch via the frozen ABI's §2.8 mapping. (2) `mov rdi, r12; call mount_op_strlen_bounded` -> rax = mount_point_len (0..256), stashed into r10 for the syscall. (3) Issue `lea rdi, [rip+mount_op_dev_path_scratch]; mov rsi, 12 (MOUNT_OP_DEV_PATH_LEN); mov rdx, r12 (mount_point_va); mov r10, rax (mount_point_len); mov r8, 5 (MOUNT_OP_BACKEND_PDXFS_BLOCK); mov rax, 75 (MOUNT_OP_SC_MOUNT); syscall` -- standard Linux SYSCALL arg convention per entry.pdx L17-22, which the kernel shuffles into SysV before reaching dispatch_mount. (4) Classify return via MOUNT_MAX=8: `mov r11, 8; cmp rax, r11; jae mount_op_kernel_error` -- rax still holds the raw return at mount_op_kernel_error. (5) Success (rax < 8): `xor r10,r10; mov [r15],r10` (raw_errno=0); `mov r13, rax` (mount_id stashed in r13 since flags is dead); `mov rdi, r13; call mount_op_append_row` (result discarded per that function's own header; the PFS-10 kernel-side APPEND_ROW stub returns 0 on R_PMT_WRITE held, INVOKE_* otherwise); `mov [r14], r13` (write mount_id); `xor rax,rax` (MOUNT_OP_OK); jmp epilogue. mount_op_kernel_error: FIRST `mov [r15], rax` (capture raw errno before rax is clobbered); `xor r10,r10; mov [r14], r10` (mount_id=0); `mov rax, 1` (MOUNT_OP_ERR_KERNEL). Epilogue pops r15/r14/r13/r12/rbx reverse-order then returns. No `add reg,[mem]` anywhere; no `test`; no `imul`. Labels prefixed mount_op_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                        // rbx = narrowed_volume_slot
        mov r12, rsi;                        // r12 = mount_point_ptr
        mov r13, rdx;                        // r13 = flags
        mov r14, rcx;                        // r14 = out_mount_id_ptr
        mov r15, r8;                         // r15 = out_raw_errno_ptr

        // ---- Gate: --dry-run? (MOUNT_OP_FLAG_DRY_RUN = 0x8) ----------------
        mov rax, r13;
        and rax, 0x8;
        cmp rax, 0;
        jne mount_op_dry_run;

        // ==================================================================
        // Real path (PFS-10): frozen path-based sys_mount ABI.
        // ==================================================================

        // ---- Step 1: build /dev/pdxvol<H> into mount_op_dev_path_scratch.
        mov rdi, rbx;
        call mount_op_build_dev_path;

        // ---- Step 2: compute mount_point_len via bounded strlen. -----------
        mov rdi, r12;
        call mount_op_strlen_bounded;
        mov r10, rax;                        // r10 = mount_point_len (staged
                                             //       for syscall arg3)

        // ---- Step 3: issue sys_mount with the frozen register layout. ------
        //   rax = 75    sysno
        //   rdi = &mount_op_dev_path_scratch   dev_path_va
        //   rsi = 12                            dev_path_len (DEV_PATH_LEN)
        //   rdx = r12                           mount_point_va
        //   r10 = mount_point_len (already in r10 from step 2)
        //   r8  = 5                             MOUNT_OP_BACKEND_PDXFS_BLOCK
        lea rdi, [rip + mount_op_dev_path_scratch];
        mov rsi, 12;                         // MOUNT_OP_DEV_PATH_LEN
        mov rdx, r12;                        // mount_point_va
        mov r8, 5;                           // MOUNT_OP_BACKEND_PDXFS_BLOCK
        mov rax, 75;                         // MOUNT_OP_SC_MOUNT
        syscall;

        // ---- Step 4: classify via MOUNT_MAX=8. ------------------------------
        mov r11, 8;                          // MOUNT_OP_MOUNT_MAX
        cmp rax, r11;
        jae mount_op_kernel_error;

        // ---- Step 5: success -- best-effort PMT_OP_APPEND_ROW. --------------
        xor r10, r10;
        mov [r15 + 0], r10;                  // *out_raw_errno_ptr = 0
        mov r13, rax;                        // r13 = mount_id (flags dead)
        mov rdi, r13;
        call mount_op_append_row;            // discard return (ABI-edge audit)

        mov [r14 + 0], r13;                  // *out_mount_id_ptr = mount_id
        xor rax, rax;                        // MOUNT_OP_OK
        jmp mount_op_done;

      mount_op_dry_run:
        xor rax, rax;
        mov [r14 + 0], rax;                  // *out_mount_id_ptr = 0
        mov [r15 + 0], rax;                  // *out_raw_errno_ptr = 0
        xor rax, rax;                        // MOUNT_OP_OK
        jmp mount_op_done;

      mount_op_kernel_error:
        mov [r15 + 0], rax;                  // *out_raw_errno_ptr = raw errno
        xor r10, r10;
        mov [r14 + 0], r10;                  // *out_mount_id_ptr = 0
        mov rax, 1;                          // MOUNT_OP_ERR_KERNEL

      mount_op_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }
}
