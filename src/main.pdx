// src/main.pdx — mount.pdxfs.M1-001 (scaffold) + M1-003 (#3) + M2-001/
// M2-002/M2-003 (#4/#5/#6) — _start
//
// mount.pdxfs is a standalone ring-3 ELF, not a library: this file is
// its `_start` entry point, argv-wired per the frozen execve ABI
// (design/user/execve-abi.md in the paideia-os monorepo), matching this
// wave's own sibling tool mkfs.pdxfs:
//
//   rdi = argc, rsi = argv (VA of a char*[], own-address-space
//   pointers -- no walker or syscall needed to dereference argv[i]),
//   rdx = envp (unused by this tool), rsp % 16 == 0 at entry.
//
// ----------------------------------------------------------------------
// M2 flow (issues #4, #5, #6) — replaces M1's dry-run-only / "not yet
// implemented" pair with the real pipeline
// ----------------------------------------------------------------------
//
//   1. Parse argv via Argv::argv_parse (src/argv.pdx, #2), unchanged
//      from M1: on a missing positional, print the matching usage
//      diagnostic to fd 2 and exit 2.
//   2. Classify <mount-point> via Elevate::elevate_needed (src/
//      elevate.pdx, #6): ELEVATE_REQUIRED (1) short-circuits straight
//      to a PdxFsMountRecord@0.1 with result_code: ELEVATION_REQUIRED
//      and exit 4 -- M3-001 is what eventually replaces this hard stop
//      with a real libpdx-elevate round trip. ELEVATE_INVALID (2) is
//      folded into the same KERNEL_ERROR path step 5 describes (no
//      dedicated result_code exists for "unclassifiable mount point"
//      at M2 -- see mount_record.pdx's own header for the four
//      result_codes this milestone carries).
//   3. Resolve + narrow <volume-cap> via VolumeCap::volume_cap_resolve
//      (src/volume_cap.pdx, #4): a non-VC_OK return (bad URI, or a
//      narrow refusal) is a KERNEL_ERROR per step 5.
//   4. Call MountOp::mount_op_invoke (src/mount_op.pdx, #5) with the
//      narrowed slot + mount-point + full flags bitmask. See that
//      file's own header for the two kernel-side gaps (sys_mount is
//      dispatch-unwired; even once wired, its real body's ABI does not
//      accept a cap slot) that mean this call ALWAYS returns
//      MOUNT_OP_ERR_KERNEL on any non-dry-run invocation today -- this
//      is the expected, documented M2 landing behaviour, not a bug in
//      this file.
//   5. Emit exactly one PdxFsMountRecord@0.1 via MountRecord::
//      mount_record_emit_result (src/mount_record.pdx, extended for
//      M2) on every path:
//        - mount_op_invoke failure (or step 2/3's own refusals) ->
//          result_code: KERNEL_ERROR, exit 3.
//        - step 2's ELEVATE_REQUIRED -> result_code:
//          ELEVATION_REQUIRED, exit 4 (both codes per
//          design/tooling/volume-tooling-ux.md §4.4's own SYSCALL_ERROR
//          (3) / NO_PERMISSION-adjacent (4) buckets).
//        - success with --dry-run set -> result_code: DRY_RUN, exit 0
//          (mount_op_invoke's own --dry-run gate skips the syscall
//          entirely, per this issue's own instruction; this file only
//          decides WHICH label to print).
//        - success without --dry-run -> result_code: OK plus the
//          returned mount_id, exit 0 -- unreachable today per step 4's
//          own gap note, kept for when the kernel-side gaps close.
//
// ----------------------------------------------------------------------
// Register plan
// ----------------------------------------------------------------------
//
// All callee-save (SysV rbx/r12-r15), so they survive every nested
// `call` below without any additional push/pop at this level -- each
// callee clobbers only caller-save registers or explicitly saves/
// restores its own callee-save use per its own justification, and
// SYSCALL preserves callee-save registers by the amd64 fast-syscall
// convention:
//
//   r14 = &ParsedArgv (the scratch struct; only needed transiently to
//         load the three fields below, then dead)
//   rbx = ParsedArgv.flags (loaded once, held for the rest of _start --
//         both the elevate/mount-op calls and the final dry-run-vs-OK
//         gate read it)
//   r15 = ParsedArgv.volume_cap_ptr (held for the rest of _start; every
//         emit call needs the raw URI string, not the narrowed slot)
//   r12 = ParsedArgv.mount_point_ptr (held for the rest of _start; both
//         elevate_needed and every downstream call need it)
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. Reserved-label discipline: every branch label in this
// file is prefixed `mount_main_`.
//
// SC+ IDs used directly by this file: 60 = sys_exit. (sys_write for the
// two usage diagnostics.) mount_op_invoke and mount_record_emit_result
// own every other syscall this binary issues.
//
// Upstream: design/tooling/volume-tooling-ux.md §4 (paideia-os);
// design/user/execve-abi.md (paideia-os, the frozen argv ABI this
// _start consumes).

module Main = structure {

  // --- ParsedArgv scratch struct (Argv::PA_STRUCT_BYTES = 24 bytes). ------
  // .bss, zero-initialised by the loader before _start runs; argv_parse
  // additionally writes every field explicitly so this function never
  // reads stale/uninit bytes even on a build where .bss zero-init were
  // somehow skipped.
  pub let mut mount_argv_out : [u8; 24] = uninit @align(8)

  // --- M2 scratch: the narrowed KIND_VOLUME cap slot (VolumeCap::
  //     volume_cap_resolve's out-param) and the mount_id MountOp::
  //     mount_op_invoke returns (0 on dry-run or any kernel error). ----
  pub let mut mount_narrowed_slot : u64 = uninit @align(8)
  pub let mut mount_id_out        : u64 = uninit @align(8)

  // --- Diagnostic messages (fd 2). -----------------------------------------
  pub let mount_msg_missing_volume_cap     : [u8; 33] = "mount.pdxfs: missing volume-cap\n\0"
  pub let mount_msg_missing_volume_cap_len : u64 = 32

  pub let mount_msg_missing_mount_point     : [u8; 34] = "mount.pdxfs: missing mount-point\n\0"
  pub let mount_msg_missing_mount_point_len : u64 = 33

  // ==========================================================================
  // _start -- user program entry point. Never returns (every terminal
  // path ends in sys_exit).
  // ==========================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched, cap},
      justification: "mount.pdxfs.M1-001/M1-003 (#3) + M2-001/M2-002/M2-003 (#4/#5/#6): mount.pdxfs _start. Stashes argc (rdi) into r12 and argv (rsi) into r13 immediately (both SysV callee-save) so they survive the `call argv_parse` below -- r12/r13 are then REPURPOSED once argv_parse returns (argc/argv are dead past that point; r12 becomes mount_point_ptr for the rest of the function, matching the module header's register plan). Phase 1 (unchanged from M1): rdi=r12(argc), rsi=r13(argv), rdx=&mount_argv_out, call argv_parse. On ARGV_ERR_MISSING_VOLUME_CAP (rax==1) or ARGV_ERR_MISSING_MOUNT_POINT (rax==2), print the matching fd-2 diagnostic and sys_exit(2) -- identical to M1. Phase 2 (on ARGV_OK): r14=&ParsedArgv; rbx=[r14+0] (flags); r15=[r14+8] (volume_cap_ptr); r12=[r14+16] (mount_point_ptr) -- r14 is dead after these three loads. Phase 3 (elevate classification, #6): rdi=r12; call elevate_needed -> rax in {0,1,2}. rax==1 (ELEVATE_REQUIRED) -> mount_main_elevation_required (emits result_code: ELEVATION_REQUIRED, exit 4). rax==2 (ELEVATE_INVALID) -> mount_main_kernel_error (folded into the same KERNEL_ERROR bucket; see module header). rax==0 falls through. Phase 4 (volume-cap resolve, #4): rdi=r15 (volume_cap_ptr), rsi=&mount_narrowed_slot (rip-relative lea); call volume_cap_resolve -> rax in {0,1,2}; non-zero -> mount_main_kernel_error. Phase 5 (mount op, #5): rdi=[rip+mount_narrowed_slot] (a plain memory-operand load, not `add reg,[mem]`), rsi=r12 (mount_point_ptr), rdx=rbx (full flags bitmask), rcx=&mount_id_out (rip-relative lea); call mount_op_invoke -> rax in {0,1}; non-zero (MOUNT_OP_ERR_KERNEL) -> mount_main_kernel_error -- per mount_op.pdx's own header this is the ALWAYS-taken branch for any non-dry-run invocation today (sys_mount is kernel-side unwired), which is the expected M2 landing behaviour. Phase 6 (success path): re-test rbx & 0x8 (Argv::PA_FLAG_DRY_RUN) to choose DRY_RUN vs OK -- mount_op_invoke's own dry-run gate already skipped the syscall internally; this second test only selects which result_code label to print, since mount_op_invoke's return alone cannot distinguish 'dry-run success' from 'real success' (both are MOUNT_OP_OK). On the dry-run branch: rdi=r15, rsi=r12, rdx=rbx, rcx=0 (MR_RESULT_DRY_RUN), r8=0 (mount_id unused); call mount_record_emit_result; exit 0. On the real-success branch: same four args plus rcx=1 (MR_RESULT_OK), r8=[rip+mount_id_out]; call mount_record_emit_result; exit 0. mount_main_elevation_required / mount_main_kernel_error each call mount_record_emit_result with rcx=2/3 respectively and r8=0 (mount_id not meaningful on either path), then exit 4 / exit 3 respectively -- the exit-code choice mirrors design/tooling/volume-tooling-ux.md §4.4's own SYSCALL_ERROR(3)/permission-adjacent(4) buckets. Every terminal path ends in sys_exit (never returns); a trailing hlt on each path is defensive belt-and-suspenders for the impossible fallthrough, matching every other _start in the paideia-os monorepo's src/user/ tree. No `add reg,[mem]`; every zero-check is cmp reg, 0 (no `test` mnemonic). Labels prefixed mount_main_.",
      block: {
        mov r12, rdi;                       // r12 = argc
        mov r13, rsi;                       // r13 = argv

        // ---- Phase 1: parse argv. ----------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        lea rdx, [rip + mount_argv_out];
        call argv_parse;

        cmp rax, 0;                          // ARGV_OK
        je mount_main_argv_ok;

        cmp rax, 1;                          // ARGV_ERR_MISSING_VOLUME_CAP
        je mount_main_missing_volume_cap;

        // ---- ARGV_ERR_MISSING_MOUNT_POINT (rax == 2) -----------------------
      mount_main_missing_mount_point:
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mount_msg_missing_mount_point];
        mov rdx, 33;                         // mount_msg_missing_mount_point_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 2;                          // status = 2 (invalid argument)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mount_main_missing_volume_cap:
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mount_msg_missing_volume_cap];
        mov rdx, 32;                         // mount_msg_missing_volume_cap_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 2;                          // status = 2 (invalid argument)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mount_main_argv_ok:
        lea r14, [rip + mount_argv_out];     // r14 = &ParsedArgv

        mov rbx, [r14 + 0];                  // rbx = flags (Argv::PA_OFF_FLAGS)
        mov r15, [r14 + 8];                  // r15 = volume_cap_ptr (Argv::PA_OFF_VOLUME_CAP_PTR)
        mov r12, [r14 + 16];                 // r12 = mount_point_ptr (Argv::PA_OFF_MOUNT_POINT_PTR)

        // ---- Phase 3: elevate classification (#6). -------------------------
        mov rdi, r12;
        call elevate_needed;

        cmp rax, 1;                          // ELEVATE_REQUIRED
        je mount_main_elevation_required;

        cmp rax, 2;                          // ELEVATE_INVALID
        je mount_main_kernel_error;

        // ---- Phase 4: volume-cap resolve + narrow (#4). --------------------
        mov rdi, r15;
        lea rsi, [rip + mount_narrowed_slot];
        call volume_cap_resolve;

        cmp rax, 0;                          // VC_OK
        jne mount_main_kernel_error;

        // ---- Phase 5: real sys_mount + mount-table append (#5). ------------
        mov rdi, [rip + mount_narrowed_slot];
        mov rsi, r12;
        mov rdx, rbx;
        lea rcx, [rip + mount_id_out];
        call mount_op_invoke;

        cmp rax, 0;                          // MOUNT_OP_OK
        jne mount_main_kernel_error;

        // ---- Phase 6: success -- DRY_RUN vs OK depends on the flag. --------
        mov rax, rbx;
        and rax, 0x8;                        // Argv::PA_FLAG_DRY_RUN
        cmp rax, 0;
        jne mount_main_emit_dry_run;

        mov rdi, r15;
        mov rsi, r12;
        mov rdx, rbx;
        mov rcx, 1;                          // MR_RESULT_OK
        mov r8, [rip + mount_id_out];
        call mount_record_emit_result;

        xor rdi, rdi;                        // status = 0 (OK)
        jmp mount_main_exit;

      mount_main_emit_dry_run:
        mov rdi, r15;
        mov rsi, r12;
        mov rdx, rbx;
        mov rcx, 0;                          // MR_RESULT_DRY_RUN
        xor r8, r8;                          // mount_id unused
        call mount_record_emit_result;

        xor rdi, rdi;                        // status = 0 (OK)
        jmp mount_main_exit;

      mount_main_elevation_required:
        mov rdi, r15;
        mov rsi, r12;
        mov rdx, rbx;
        mov rcx, 2;                          // MR_RESULT_ELEVATION_REQUIRED
        xor r8, r8;                          // mount_id unused
        call mount_record_emit_result;

        mov rdi, 4;                          // status = 4
        jmp mount_main_exit;

      mount_main_kernel_error:
        mov rdi, r15;
        mov rsi, r12;
        mov rdx, rbx;
        mov rcx, 3;                          // MR_RESULT_KERNEL_ERROR
        xor r8, r8;                          // mount_id unused
        call mount_record_emit_result;

        mov rdi, 3;                          // status = 3

      mount_main_exit:
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    }
}
