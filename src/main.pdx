// src/main.pdx — mount.pdxfs.M1-001 (scaffold) + M1-003 (#3) — _start
//
// mount.pdxfs is a standalone ring-3 ELF, not a library: this file is
// its `_start` entry point, argv-wired per the frozen execve ABI
// (design/user/execve-abi.md in the paideia-os monorepo), matching this
// wave's own sibling tool mkfs.pdxfs:
//
//   rdi = argc, rsi = argv (VA of a char*[], own-address-space
//   pointers -- no walker or syscall needed to dereference argv[i]),
//   rdx = envp (unused by this tool), rsp % 16 == 0 at entry.
//
// M1 flow (mount.pdxfs.M1-003, issue #3):
//
//   1. Parse argv via Argv::argv_parse (src/argv.pdx, #2). On
//      ARGV_ERR_MISSING_VOLUME_CAP or ARGV_ERR_MISSING_MOUNT_POINT,
//      print the matching usage diagnostic to fd 2 and exit 2 (matches
//      design/tooling/volume-tooling-ux.md §4.4's exit-code convention
//      of using a distinct low exit code for a malformed invocation,
//      extended here -- same as mkfs.pdxfs.M1-003 -- to cover a missing
//      positional as the same misuse class).
//   2. If --dry-run is set: call MountRecord::mount_record_emit_dry_run
//      (src/mount_record.pdx, #3) to print the PdxFsMountRecord@0.1
//      line, then exit 0. Unlike mkfs.pdxfs, there is no target-
//      taxonomy gate here -- mount.pdxfs's --dry-run happy path is not
//      scoped to any particular <volume-cap> or <mount-point> shape at
//      M1 (this tool's own task brief has no target-classification
//      concept analogous to mkfs.pdxfs's file-vs-device-cap split).
//   3. Otherwise (no --dry-run): print "mount.pdxfs: not yet
//      implemented\n" to fd 2 and exit 1 -- the real write path
//      (volume-cap resolution + narrow, sys_mount, mount-table row
//      append) lands at mount.pdxfs.M2 per
//      design/tooling/volume-tooling-ux.md §9.2.
//
// ----------------------------------------------------------------------
// Register plan
// ----------------------------------------------------------------------
//
// All callee-save (SysV rbx/r12-r15), so they survive the nested
// `call`s (argv_parse, mount_record_emit_dry_run) without any
// additional push/pop at this level -- each callee clobbers only
// caller-save registers or explicitly saves/restores its own
// callee-save use per its own justification, and SYSCALL preserves
// callee-save registers by the amd64 fast-syscall convention:
//
//   r12 = argc (saved immediately from rdi, before any call)
//   r13 = argv (saved immediately from rsi)
//   r14 = &mount_argv_out (the ParsedArgv scratch struct, lea'd once)
//   rbx = ParsedArgv.flags (loaded once after argv_parse succeeds)
//   r15 = ParsedArgv.volume_cap_ptr (loaded once after argv_parse
//         succeeds)
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. Reserved-label discipline: every branch label in this
// file is prefixed `mount_main_`.
//
// SC+ IDs used (same frozen ordinals every src/user/*.pdx binary in the
// paideia-os monorepo uses, and the same two mkfs.pdxfs.M1-003 uses):
// 1 = sys_write(fd, buf, count), 60 = sys_exit(status).
//
// Upstream: design/tooling/volume-tooling-ux.md §4 (paideia-os);
// design/user/execve-abi.md (paideia-os, the frozen argv ABI this
// _start consumes).

module Main = structure {

  // --- ParsedArgv scratch struct (Argv::PA_STRUCT_BYTES = 24 bytes). ------
  // .bss, zero-initialised by the loader before _start runs; argv_parse
  // additionally writes every field explicitly so this function never
  // reads stale/uninit bytes even on a build where .bss zero-init were
  // somehow skipped.
  pub let mut mount_argv_out : [u8; 24] = uninit @align(8)

  // --- Diagnostic messages (fd 2). -----------------------------------------
  pub let mount_msg_missing_volume_cap     : [u8; 33] = "mount.pdxfs: missing volume-cap\n\0"
  pub let mount_msg_missing_volume_cap_len : u64 = 32

  pub let mount_msg_missing_mount_point     : [u8; 34] = "mount.pdxfs: missing mount-point\n\0"
  pub let mount_msg_missing_mount_point_len : u64 = 33

  pub let mount_msg_not_implemented     : [u8; 34] = "mount.pdxfs: not yet implemented\n\0"
  pub let mount_msg_not_implemented_len : u64 = 33

  // ==========================================================================
  // _start -- user program entry point. Never returns (every terminal
  // path ends in sys_exit).
  // ==========================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "mount.pdxfs.M1-001 (scaffold) + M1-003 (#3): mount.pdxfs _start. Stashes argc (rdi) into r12 and argv (rsi) into r13 immediately (both SysV callee-save) so they survive the `call argv_parse` below. Phase 1: rdi=r12, rsi=r13, rdx=&mount_argv_out (rip-relative lea), call argv_parse (src/argv.pdx, #2). On ARGV_ERR_MISSING_VOLUME_CAP (rax==1): jump to mount_main_missing_volume_cap: sys_write(2, mount_msg_missing_volume_cap, 32), sys_exit(2). On ARGV_ERR_MISSING_MOUNT_POINT (rax==2): jump to mount_main_missing_mount_point: sys_write(2, mount_msg_missing_mount_point, 33), sys_exit(2) -- exit code 2 for both missing-positional cases matches design/tooling/volume-tooling-ux.md §4.4's low-exit-code convention for a malformed invocation, extended here (same posture as mkfs.pdxfs.M1-003) to cover a missing positional as the same misuse class. Phase 2 (on ARGV_OK, rax==0): r14 = &mount_argv_out (rip-relative lea, held for the rest of _start); rbx = [r14+0] (ParsedArgv.flags, Argv::PA_OFF_FLAGS); r15 = [r14+8] (ParsedArgv.volume_cap_ptr, Argv::PA_OFF_VOLUME_CAP_PTR). Gate: rax = rbx & 0x8 (Argv::PA_FLAG_DRY_RUN); cmp rax, 0; je mount_main_not_implemented when --dry-run was not given. On --dry-run set: rdi = r15 (volume_cap_ptr), rsi = [r14+16] (ParsedArgv.mount_point_ptr, Argv::PA_OFF_MOUNT_POINT_PTR), rdx = rbx (flags, the full ParsedArgv.flags bitmask); call mount_record_emit_dry_run (src/mount_record.pdx, #3) -- prints the PdxFsMountRecord@0.1 line to fd 1. Then sys_exit(0). mount_main_not_implemented: sys_write(2, mount_msg_not_implemented, 33), sys_exit(1) -- the real write path (volume-cap resolve+narrow, sys_mount, mount-table row append) is mount.pdxfs.M2, not yet implemented. Every terminal path ends in sys_exit (never returns); a trailing hlt on each path is defensive belt-and-suspenders for the impossible fallthrough, matching every other _start in the paideia-os monorepo's src/user/ tree and mkfs.pdxfs's own main.pdx. No `add reg,[mem]`; every zero-check is cmp reg, 0 (no `test` mnemonic). Labels prefixed mount_main_.",
      block: {
        mov r12, rdi;                       // r12 = argc
        mov r13, rsi;                       // r13 = argv

        // ---- Phase 1: parse argv. ----------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        lea rdx, [rip + mount_argv_out];
        call argv_parse;

        cmp rax, 0;                          // ARGV_OK
        je mount_main_argv_ok;

        cmp rax, 1;                          // ARGV_ERR_MISSING_VOLUME_CAP
        je mount_main_missing_volume_cap;

        // ---- ARGV_ERR_MISSING_MOUNT_POINT (rax == 2) -----------------------
      mount_main_missing_mount_point:
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mount_msg_missing_mount_point];
        mov rdx, 33;                         // mount_msg_missing_mount_point_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 2;                          // status = 2 (invalid argument)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mount_main_missing_volume_cap:
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mount_msg_missing_volume_cap];
        mov rdx, 32;                         // mount_msg_missing_volume_cap_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 2;                          // status = 2 (invalid argument)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mount_main_argv_ok:
        lea r14, [rip + mount_argv_out];     // r14 = &ParsedArgv

        mov rbx, [r14 + 0];                  // rbx = flags (Argv::PA_OFF_FLAGS)
        mov r15, [r14 + 8];                  // r15 = volume_cap_ptr (Argv::PA_OFF_VOLUME_CAP_PTR)

        // ---- Gate: --dry-run set? (Argv::PA_FLAG_DRY_RUN = 0x8) -----------
        mov rax, rbx;
        and rax, 0x8;
        cmp rax, 0;
        je mount_main_not_implemented;

        // ---- --dry-run: emit the mount record. -----------------------------
        mov rdi, r15;                        // volume_cap_ptr
        mov rsi, [r14 + 16];                 // mount_point_ptr (Argv::PA_OFF_MOUNT_POINT_PTR)
        mov rdx, rbx;                        // flags
        call mount_record_emit_dry_run;

        xor rdi, rdi;                        // status = 0 (OK)
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mount_main_not_implemented:
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mount_msg_not_implemented];
        mov rdx, 33;                         // mount_msg_not_implemented_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 1;                          // status = 1
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    }
}
