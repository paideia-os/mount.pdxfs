// src/argv.pdx — mount.pdxfs.ENH-030 satellite adoption of libpdx-argv v1.1.0
//
// R90-XREPO satellite cascade, mount.pdxfs branch (issue #25):
// replaces the handwritten long-flag scanner this file used through
// v1.1.2 with a thin wire-in over libpdx-argv (paideia-satellites/
// libpdx-argv v1.1.0, ENH-030 rename tag). Every public symbol callers
// depend on -- the `argv_parse` entry point, the `PA_OFF_*` /
// `PA_FLAG_*` / `PA_STRUCT_BYTES` constants -- keeps its numeric value
// and its byte offset unchanged, so `src/main.pdx`'s direct-offset
// loads (`[r14 + 0]` for flags, `[r14 + 8]` for volume_cap_ptr,
// `[r14 + 16]` for mount_point_ptr, `[r14 + 24]` for snapshot_slot)
// and `tests/test_happy_mnt.pdx`'s `thm_parsed: [u8; 24]` buffer with
// its reads at offsets +8/+16 both continue to work byte-for-byte.
//
// ----------------------------------------------------------------------
// libpdx-argv wire-in shape
// ----------------------------------------------------------------------
//
// `argv_parse(argc, argv, out_ptr)` now:
//   1. Zero-initialises the caller's 48-byte ParsedArgv scratch
//      struct. Every slot defaults to 0 except PA_OFF_PASSPHRASE_FD
//      (+32), which gets the i64 sentinel -1 (0xFFFF...FFFF as u64)
//      matching pre-shim behaviour -- the "unset" sentinel that
//      distinguishes "left unset" from "explicitly set to fd 0" for
//      the passphrase-fd unlock hop.
//   2. Calls `flag_spec_reset()`, then `flag_spec_register()` eight
//      times -- once per mount.pdxfs long flag, binding each name to
//      a value kind (`FKIND_BOOL` / `FKIND_INT`) and a caller-chosen
//      numeric ID from the FID_* space this module owns.
//   3. Calls `parsed_args_reset()`.
//   4. Calls `parse_argv(argv+8, argc-1)` -- +8/-1 skips argv[0].
//      Return value IGNORED; the shim reads whatever ParsedArgs holds
//      even on a soft error.
//   5. Walks `flag_ids[0..flag_count)` once. Boolean FID_* cases OR
//      the matching PA_FLAG_* bit into the running flags-mask; the
//      two value-carrying flags (--snapshot, --passphrase-fd) pipe
//      `flag_values[k]` through `parse_int_u64` and store the result
//      into the matching PA_OFF_* slot. --snapshot additionally
//      implies PA_FLAG_RO (matches the pre-shim v1.1.2 behaviour: a
//      snap mount is read-only per src/snapshot_wire.pdx, expressed
//      as `or rax, 0x41 = PA_FLAG_SNAPSHOT_SET | PA_FLAG_RO`).
//   6. Populates volume_cap_ptr (+8) from pos_ptrs[0] and
//      mount_point_ptr (+16) from pos_ptrs[1] when the respective
//      positional was seen -- mount.pdxfs takes TWO positionals.
//   7. Applies the M6 relax-gates for the three modes that override
//      the two-positional requirement:
//        --all             -> neither positional required; ARGV_OK.
//        --snapshot-list   -> volume-cap only; mount-point unused.
//        --snapshot=<slot> -> mount-point only; volume-cap unused.
//      Only when NONE of these bits are set does the shim enforce
//      the strict "volume-cap AND mount-point present" rule -- and
//      when it doesn't hold, returns ARGV_ERR_MISSING_VOLUME_CAP (1)
//      or ARGV_ERR_MISSING_MOUNT_POINT (2) as before.
//
// ----------------------------------------------------------------------
// Preserved surface (byte-for-byte with the pre-shim v1.1.2 body)
// ----------------------------------------------------------------------
//
// - PA_OFF_FLAGS = 0, PA_OFF_VOLUME_CAP_PTR = 8, PA_OFF_MOUNT_POINT_PTR
//   = 16, PA_OFF_SNAPSHOT_SLOT = 24, PA_OFF_PASSPHRASE_FD = 32,
//   PA_OFF_RESERVED_M6 = 40 -- PA_STRUCT_BYTES = 48. Every offset
//   matches the pre-shim layout verbatim.
// - PA_FLAG_RO = 0x1, PA_FLAG_NOEXEC = 0x2, PA_FLAG_VERBOSE = 0x4,
//   PA_FLAG_DRY_RUN = 0x8, PA_FLAG_ALL = 0x10,
//   PA_FLAG_SNAPSHOT_LIST = 0x20, PA_FLAG_SNAPSHOT_SET = 0x40,
//   PA_FLAG_PASSPHRASE_FD_SET = 0x80 -- byte-identical bits.
// - --snapshot=<slot> ORs PA_FLAG_RO (0x1) into flags alongside
//   PA_FLAG_SNAPSHOT_SET (0x40) -- the "snap mount is RO" invariant.
// - passphrase_fd default is the i64 sentinel -1 (as u64:
//   0xFFFFFFFFFFFFFFFF), preserved from pre-shim.
// - ARGV_OK = 0, ARGV_ERR_MISSING_VOLUME_CAP = 1,
//   ARGV_ERR_MISSING_MOUNT_POINT = 2.
//
// ----------------------------------------------------------------------
// Encoder-gap discipline (per project-wide non-negotiable)
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. Byte loads use xor+mov_b per
// paideia-as #1248. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. Every `cmp reg, imm` uses imm ≤ 0x7FFFFFFF (max seen:
// 107 for FID_PASSPHRASE_FD). The i64 -1 sentinel is staged through
// a register (mov r10, 0xFFFFFFFFFFFFFFFF) because -1 is a u64 imm64.
// r11 is scratch (used for every lea to a cross-module .bss base).
// Reserved-label discipline: every label in this file is prefixed
// `mount_argv_`.
//
// Upstream: paideia-satellites/libpdx-argv v1.1.0 (ENH-030 rename);
// design/tooling/volume-tooling-ux.md §4.1 (paideia-os, the frozen
// argv surface this shim implements against).

module Argv = structure {

  // --- ParsedArgv out-struct offsets (unchanged from v1.1.2). -----------
  pub let PA_OFF_FLAGS           : u64 = 0
  pub let PA_OFF_VOLUME_CAP_PTR  : u64 = 8
  pub let PA_OFF_MOUNT_POINT_PTR : u64 = 16
  pub let PA_OFF_SNAPSHOT_SLOT   : u64 = 24
  pub let PA_OFF_PASSPHRASE_FD   : u64 = 32
  pub let PA_OFF_RESERVED_M6     : u64 = 40
  pub let PA_STRUCT_BYTES        : u64 = 48

  // --- ParsedArgv.flags bit assignments (unchanged from v1.1.2). --------
  pub let PA_FLAG_RO                : u64 = 0x1
  pub let PA_FLAG_NOEXEC            : u64 = 0x2
  pub let PA_FLAG_VERBOSE           : u64 = 0x4
  pub let PA_FLAG_DRY_RUN           : u64 = 0x8
  pub let PA_FLAG_ALL               : u64 = 0x10
  pub let PA_FLAG_SNAPSHOT_LIST     : u64 = 0x20
  pub let PA_FLAG_SNAPSHOT_SET      : u64 = 0x40
  pub let PA_FLAG_PASSPHRASE_FD_SET : u64 = 0x80

  pub let ARGV_OK                       : u64 = 0
  pub let ARGV_ERR_MISSING_VOLUME_CAP   : u64 = 1
  pub let ARGV_ERR_MISSING_MOUNT_POINT  : u64 = 2

  // --- FID_* numbering (owned by this shim; see module header). ---------
  pub let FID_RO             : u64 = 100
  pub let FID_NOEXEC         : u64 = 101
  pub let FID_VERBOSE        : u64 = 102
  pub let FID_DRY_RUN        : u64 = 103
  pub let FID_ALL            : u64 = 104
  pub let FID_SNAPSHOT_LIST  : u64 = 105
  pub let FID_SNAPSHOT       : u64 = 106
  pub let FID_PASSPHRASE_FD  : u64 = 107

  // --- Flag-name literals for flag_spec_register (NUL-terminated, no
  //     leading "--" -- libpdx-argv's parser strips the '--' prefix). ---
  pub let mount_argv_name_ro             : [u8; 3]  = "ro\0"
  pub let mount_argv_name_noexec         : [u8; 7]  = "noexec\0"
  pub let mount_argv_name_verbose        : [u8; 8]  = "verbose\0"
  pub let mount_argv_name_dry_run        : [u8; 8]  = "dry-run\0"
  pub let mount_argv_name_all            : [u8; 4]  = "all\0"
  pub let mount_argv_name_snapshot_list  : [u8; 14] = "snapshot-list\0"
  pub let mount_argv_name_snapshot       : [u8; 9]  = "snapshot\0"
  pub let mount_argv_name_passphrase_fd  : [u8; 14] = "passphrase-fd\0"

  // ==========================================================================
  // argv_parse(argc, argv, out_ptr) -> u64
  //   rdi = argc  (per the frozen execve ABI)
  //   rsi = argv  (VA of a char*[]; argv[0] is the program name)
  //   rdx = out_ptr (48-byte ParsedArgv struct, caller-allocated .bss)
  //   rax = ARGV_OK (0), ARGV_ERR_MISSING_VOLUME_CAP (1), or
  //         ARGV_ERR_MISSING_MOUNT_POINT (2).
  //
  // Register plan (5 callee-save pushes -> rsp%16 = 0 for nested calls):
  //   rbx = out_ptr        (survives every libpdx-argv call below)
  //   r12 = argc / repurposed after parse_argv to flag_count
  //   r13 = argv / repurposed after parse_argv to loop index i
  //   r14 = accumulated flags mask
  //   r15 = unused past the parse (kept saved for register-parity)
  //
  // Scratch (caller-save; trashed across every call):
  //   rax, rcx, rdx, rdi, rsi, r8, r9, r10, r11
  // ==========================================================================
  pub let argv_parse : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (argc: u64) (argv: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "mount.pdxfs.ENH-030 (#25): argv_parse shim over libpdx-argv v1.1.0. Entry rsp%16=8 (post-call); pushes 5 callee-save regs (rbx/r12/r13/r14/r15) -> rsp%16=0 for every nested call site (flag_spec_reset, flag_spec_register x8, parsed_args_reset, parse_argv, parse_int_u64 x2). rbx holds the caller's out_ptr through every call; r12/r13 initially hold argc/argv (for the argv+8/argc-1 skip below) and are repurposed post-parse_argv to flag_count / loop index; r14 accumulates the flags mask; r15 is saved for register-count parity but unused past the parse. Zero-init pass: writes flags=0, volume_cap_ptr=0, mount_point_ptr=0, snapshot_slot=0, passphrase_fd=-1 (0xFFFFFFFFFFFFFFFF as u64 -- the i64 unset-sentinel staged through r10 because -1 is a u64 imm64), reserved=0 into the 48-byte out struct BEFORE any libpdx-argv call. Registration pass: eight flag_spec_register calls -- (ro,BOOL,100), (noexec,BOOL,101), (verbose,BOOL,102), (dry-run,BOOL,103), (all,BOOL,104), (snapshot-list,BOOL,105), (snapshot,INT,106), (passphrase-fd,INT,107). Parse: rdi=r13+8 (argv+8 skips argv[0]), rsi=r12-1 (argc-1); call parse_argv; return code IGNORED (see mkfs.pdxfs.ENH-030 for the permissive-posture rationale). Walk pass: r12=[flag_count], r13=0 (loop index), r14=0 (flags mask). Each iteration: r10=flag_ids[r13]; cmp against every FID_* in ascending order; on a match, either OR the matching PA_FLAG_* into r14 or read flag_values[r13] into the matching PA_OFF_* slot. --snapshot (FID_SNAPSHOT=106) ORs both PA_FLAG_SNAPSHOT_SET (0x40) AND PA_FLAG_RO (0x1) into r14 as 0x41 -- matches pre-shim v1.1.2's `or rax, 0x41` idiom that expresses the 'snap mount is RO' invariant per src/snapshot_wire.pdx. --snapshot and --passphrase-fd pipe their value strings through parse_int_u64 (Typed::parse_int_u64 return: rax=ok, rdx=val); on a parse failure the shim leaves the default in place and does not latch the presence bit (a mild behaviour change vs. the pre-shim `argv_parse_u64_dec` which always latched -- no test consults these presence bits on a malformed value). Post-walk: writes r14 into PA_OFF_FLAGS (+0). Positional pass: reads pos_count; pos_ptrs[0] -> PA_OFF_VOLUME_CAP_PTR (+8) if count >= 1; pos_ptrs[1] -> PA_OFF_MOUNT_POINT_PTR (+16) if count >= 2 -- mount.pdxfs takes exactly two positionals in the legacy surface. Relax-gates: if PA_FLAG_ALL (0x10) is set, neither positional is required -> ARGV_OK. Else if PA_FLAG_SNAPSHOT_SET (0x40) is set, only mount_point_ptr is required (volume-cap unused on the snap-mount path). Else volume_cap_ptr must be present or return ARGV_ERR_MISSING_VOLUME_CAP=1. Then if PA_FLAG_SNAPSHOT_LIST (0x20) is set, mount_point_ptr is not required -> ARGV_OK; else mount_point_ptr must be present or return ARGV_ERR_MISSING_MOUNT_POINT=2. Every relax-gate matches the pre-shim `mount_argv_ok_short`/`mount_argv_skip_volume_check`/`mount_argv_missing_*` logic byte-for-byte in return codes and precedence order. Epilogue pops r15/r14/r13/r12/rbx (reverse push order) then rets. No `add reg,[mem]`; no `test` mnemonic; every cmp reg,imm ≤ 0x7FFFFFFF. Labels prefixed mount_argv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdx;                       // rbx = out_ptr
        mov r12, rdi;                       // r12 = argc
        mov r13, rsi;                       // r13 = argv

        // ---- Zero-init pass (+ passphrase_fd = -1 sentinel). ------------
        xor rax, rax;
        mov [rbx + 0], rax;                 // flags = 0
        mov [rbx + 8], rax;                 // volume_cap_ptr = 0
        mov [rbx + 16], rax;                // mount_point_ptr = 0
        mov [rbx + 24], rax;                // snapshot_slot = 0
        mov r10, 0xFFFFFFFFFFFFFFFF;        // i64 -1 (unset sentinel)
        mov [rbx + 32], r10;                // passphrase_fd = -1
        mov [rbx + 40], rax;                // reserved = 0

        // ---- Register the 8 flags with libpdx-argv's FlagSpec. ----------
        call flag_spec_reset;

        lea rdi, [rip + mount_argv_name_ro];
        mov rsi, 0;                         // FKIND_BOOL
        mov rdx, 100;                       // FID_RO
        call flag_spec_register;

        lea rdi, [rip + mount_argv_name_noexec];
        mov rsi, 0;
        mov rdx, 101;                       // FID_NOEXEC
        call flag_spec_register;

        lea rdi, [rip + mount_argv_name_verbose];
        mov rsi, 0;
        mov rdx, 102;                       // FID_VERBOSE
        call flag_spec_register;

        lea rdi, [rip + mount_argv_name_dry_run];
        mov rsi, 0;
        mov rdx, 103;                       // FID_DRY_RUN
        call flag_spec_register;

        lea rdi, [rip + mount_argv_name_all];
        mov rsi, 0;
        mov rdx, 104;                       // FID_ALL
        call flag_spec_register;

        lea rdi, [rip + mount_argv_name_snapshot_list];
        mov rsi, 0;
        mov rdx, 105;                       // FID_SNAPSHOT_LIST
        call flag_spec_register;

        lea rdi, [rip + mount_argv_name_snapshot];
        mov rsi, 2;                         // FKIND_INT
        mov rdx, 106;                       // FID_SNAPSHOT
        call flag_spec_register;

        lea rdi, [rip + mount_argv_name_passphrase_fd];
        mov rsi, 2;                         // FKIND_INT
        mov rdx, 107;                       // FID_PASSPHRASE_FD
        call flag_spec_register;

        // ---- Reset ParsedArgs bookkeeping + drive the parse. ------------
        call parsed_args_reset;

        mov rdi, r13;
        add rdi, 8;                         // argv+8
        mov rsi, r12;
        sub rsi, 1;                         // argc-1
        call parse_argv;
        // rax = error code; deliberately IGNORED.

        // ---- Walk flag_ids[0..flag_count) once. -------------------------
        lea r11, [rip + flag_count];
        mov r12, [r11];                     // r12 = flag_count
        xor r13, r13;                       // r13 = i = 0
        xor r14, r14;                       // r14 = flags mask = 0

      mount_argv_walk_loop:
        cmp r13, r12;
        jge mount_argv_walk_done;

        lea r11, [rip + flag_ids];
        mov r10, [r11 + r13*8];             // r10 = flag_ids[i]

        cmp r10, 100;                       // FID_RO
        jne mount_argv_case_noexec;
        or r14, 0x1;                        // PA_FLAG_RO
        jmp mount_argv_walk_next;

      mount_argv_case_noexec:
        cmp r10, 101;                       // FID_NOEXEC
        jne mount_argv_case_verbose;
        or r14, 0x2;                        // PA_FLAG_NOEXEC
        jmp mount_argv_walk_next;

      mount_argv_case_verbose:
        cmp r10, 102;                       // FID_VERBOSE
        jne mount_argv_case_dry_run;
        or r14, 0x4;                        // PA_FLAG_VERBOSE
        jmp mount_argv_walk_next;

      mount_argv_case_dry_run:
        cmp r10, 103;                       // FID_DRY_RUN
        jne mount_argv_case_all;
        or r14, 0x8;                        // PA_FLAG_DRY_RUN
        jmp mount_argv_walk_next;

      mount_argv_case_all:
        cmp r10, 104;                       // FID_ALL
        jne mount_argv_case_snap_list;
        or r14, 0x10;                       // PA_FLAG_ALL
        jmp mount_argv_walk_next;

      mount_argv_case_snap_list:
        cmp r10, 105;                       // FID_SNAPSHOT_LIST
        jne mount_argv_case_snapshot;
        or r14, 0x20;                       // PA_FLAG_SNAPSHOT_LIST
        jmp mount_argv_walk_next;

      mount_argv_case_snapshot:
        cmp r10, 106;                       // FID_SNAPSHOT
        jne mount_argv_case_passphrase_fd;
        lea r11, [rip + flag_values];
        mov rdi, [r11 + r13*8];
        call parse_int_u64;                 // rax=ok, rdx=val
        cmp rax, 0;
        je mount_argv_walk_next;
        mov [rbx + 24], rdx;                // snapshot_slot
        or r14, 0x41;                       // PA_FLAG_SNAPSHOT_SET | PA_FLAG_RO
        jmp mount_argv_walk_next;

      mount_argv_case_passphrase_fd:
        cmp r10, 107;                       // FID_PASSPHRASE_FD
        jne mount_argv_walk_next;
        lea r11, [rip + flag_values];
        mov rdi, [r11 + r13*8];
        call parse_int_u64;
        cmp rax, 0;
        je mount_argv_walk_next;
        mov [rbx + 32], rdx;                // passphrase_fd
        or r14, 0x80;                       // PA_FLAG_PASSPHRASE_FD_SET

      mount_argv_walk_next:
        add r13, 1;
        jmp mount_argv_walk_loop;

      mount_argv_walk_done:
        mov [rbx + 0], r14;                 // flags

        // ---- Positional pass. --------------------------------------------
        lea r11, [rip + pos_count];
        mov rax, [r11];

        cmp rax, 0;
        je mount_argv_pos_done;             // no positionals

        lea r11, [rip + pos_ptrs];
        mov r9, [r11 + 0];                  // pos_ptrs[0]
        mov [rbx + 8], r9;                  // volume_cap_ptr

        cmp rax, 1;
        je mount_argv_pos_done;             // only one positional

        lea r11, [rip + pos_ptrs];
        mov r9, [r11 + 8];                  // pos_ptrs[1]
        mov [rbx + 16], r9;                 // mount_point_ptr

      mount_argv_pos_done:
        // ---- Relax-gate: --all overrides both positional checks. --------
        mov rax, r14;
        and rax, 0x10;                      // PA_FLAG_ALL
        cmp rax, 0;
        jne mount_argv_ok_short;

        // ---- --snapshot=<slot> relax-gate on volume_cap. ----------------
        mov rax, r14;
        and rax, 0x40;                      // PA_FLAG_SNAPSHOT_SET
        cmp rax, 0;
        jne mount_argv_skip_vc_check;

        mov rax, [rbx + 8];                 // volume_cap_ptr
        cmp rax, 0;
        je mount_argv_missing_vc;

      mount_argv_skip_vc_check:
        // ---- --snapshot-list relax-gate on mount_point. -----------------
        mov rax, r14;
        and rax, 0x20;                      // PA_FLAG_SNAPSHOT_LIST
        cmp rax, 0;
        jne mount_argv_ok_short;

        mov rax, [rbx + 16];                // mount_point_ptr
        cmp rax, 0;
        je mount_argv_missing_mp;

      mount_argv_ok_short:
        xor rax, rax;                       // ARGV_OK
        jmp mount_argv_epilogue;

      mount_argv_missing_vc:
        mov rax, 1;                         // ARGV_ERR_MISSING_VOLUME_CAP
        jmp mount_argv_epilogue;

      mount_argv_missing_mp:
        mov rax, 2;                         // ARGV_ERR_MISSING_MOUNT_POINT

      mount_argv_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }
}
